# adhde prompt theme

prompt_adhde_help() {
    cat <<'EOF'
prompt adhde [<maincolor>] [nouser] [nohost] [fullcwd] [noexitcode] [novcs] [noclock]

By default, main color is cyan

- nouser: hide username
- nohost: hide hostname
- fullcwd: do not replace $HOME with ~ and do not reduce parent dirnames to one character
- noexitcode: do not show exitcode
- succexitcode: show exit code on success
- novcs: do not show vcs status
- noexecdur: do not show last cmd execution duration
- noclock: do not show date/time

EOF
}

prompt_adhde_setup() {

    opt_user=true
    opt_host=true
    opt_fullcwd=false
    opt_exitcode=true
    opt_succexitcode=false
    opt_vcs=true
    opt_execdur=true
    opt_clock=true
    opt_maincolor='cyan'

    if [ -n "$*" ]; then
        opt_maincolor="$1"
        shift 1
    fi

    for option in "$@"; do
        case "$option" in
            nouser)
                opt_user=false;;
            nohost)
                opt_host=false;;
            fullcwd)
                opt_fullcwd=true;;
            noexitcode)
                opt_exitcode=false;;
            succexitcode)
                opt_succexitcode=true;;
            novcs)
                opt_vcs=false;;
            noexecdur)
                opt_execdur=false;;
            noclock)
                opt_clock=false;;
        esac
    done

    mc="%F{$opt_maincolor}"

    prompt_opts=(cr subst percent)
    # setopt localoptions nowarncreateglobal
    
    if $opt_vcs; then
        autoload -Uz vcs_info
        zstyle ':vcs_info:git:*' check-for-changes true
        zstyle ':vcs_info:*' unstagedstr ' %B%F{red}U%f%b'
        zstyle ':vcs_info:*' stagedstr ' %B%F{green}S%f%b'
        zstyle ':vcs_info:*' formats " ${mc}[%f%s:%%B%b%%b%u%c${mc}]%f"
    fi
    
    if $opt_execdur; then
        zmodload zsh/datetime # faster than `date`
        add-zsh-hook preexec _mark_start_ts
        _mark_start_ts # init value
    fi
    add-zsh-hook precmd prompt_adhde_precmd
}

prompt_adhde_precmd() {

    local exit_code="$?"
    local p_exit_code
    local show_exit_code=false
    if $opt_exitcode; then
        if [ "$exit_code" = "0" ]; then
            if $opt_succexitcode; then
                show_exit_code=true
                p_exit_code="%B%F{green}%?%f%b"
            fi
        else
            show_exit_code=true
            p_exit_code="%B%F{red}%?%f%b"
        fi
    fi

    local execduration
    if $opt_execdur; then
        local elapsed=$((EPOCHSECONDS - theme_cmd_timestamp))
        local days="$((elapsed / 86400))d "
        local hours="$((elapsed % 86400 / 3600))h "
        local minutes="$((elapsed % 3600 / 60))m "
        local seconds="$((elapsed % 60))s"
        [ "$days" = "0d " ] && days=""
        [ "$hours" = "0h " ] && hours=""
        [ "$minutes" = "0m " ] && minutes=""
        execduration="${days}${hours}${minutes}${seconds}"
    fi

    local cmdresult
    local cmd_result_separator=""
    if $show_exit_code || $opt_execdur; then
        $show_exit_code && $opt_execdur && cmd_result_separator=" "
        cmdresult=" ${mc}(%f${p_exit_code}${cmd_result_separator}${execduration}${mc})%f "
    fi

    local userhost
    if $opt_user && $opt_host; then
        userhost="[%f%B%n%b${mc}@%f%B%M%b${mc}]%f "
    elif $opt_user; then
        userhost="[%f%B%n%b${mc}]%f "
    elif $opt_host; then
        userhost="[%f%B%M%b${mc}]%f "
    fi

    local cwd="${mc}(%f%B$(_short_cwd)%b${mc})%f"
    if $opt_fullcwd; then
        cwd="${mc}(%f%B%/%b${mc})%f"
    fi

    local clock
    if $opt_clock; then
        local dot="${mc}.%f"
        local col="${mc}:%f"
        clock="     %B%D{%d}${dot}%D{%m}${dot}%D{%Y} %D{%H}${col}%D{%M}${col}%D{%S}%b"
    fi

    local vcsstatus
    if $opt_vcs; then
        vcs_info
        vcsstatus="${vcs_info_msg_0_}"
    fi

    PS1="${mc}┌${userhost}${cwd}${cmdresult}${vcsstatus}${clock}${prompt_newline}${mc}└>%f "
    PS2="${mc}%_> %f"
}

_mark_start_ts() {
  theme_cmd_timestamp=$EPOCHSECONDS
}

_short_cwd() {
    local p="${(%):-%~}"
    local -a parts
    parts=("${(@s:/:)p}")

    local i last=$#parts
    for (( i = 1; i < last; i++ )); do
        [[ -z "$parts[i]" || "$parts[i]" == "~" ]] && continue

        if [[ "$parts[i]" == .* && ${#parts[i]} -gt 1 ]]; then
            parts[i]="${parts[i][1,2]}"
        else
            parts[i]="${parts[i][1]}"
        fi
    done

    print -r -- "${(j:/:)parts}"
}

prompt_adhde_preview() {
    prompt_preview_theme adhde
    print
    prompt_preview_theme adhde blue nouser
    print
    prompt_preview_theme adhde magenta nohost
    print
    prompt_preview_theme adhde red nouser nohost
    print
    prompt_preview_theme adhde '#F8B028' noexitcode noclock
    print
    prompt_preview_theme adhde '#E060C0' fullcwd novcs
}

prompt_adhde_setup "$@"

